OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Springroll's Google OAuth Web application client (Gmail, Calendar, Drive)
SPRINGROLL_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SPRINGROLL_GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# One Entra ID Web app powers Outlook, OneDrive, Teams, and SharePoint.
SPRINGROLL_MICROSOFT_OAUTH_CLIENT_ID=your-entra-application-client-id
SPRINGROLL_MICROSOFT_OAUTH_CLIENT_SECRET=your-entra-client-secret
# common supports personal plus work/school accounts; use a tenant ID to restrict it.
SPRINGROLL_MICROSOFT_OAUTH_TENANT=common

# Optional: enables Sign in with Slack once Springroll's Slack app exists
SPRINGROLL_SLACK_OAUTH_CLIENT_ID=your-slack-client-id
SPRINGROLL_SLACK_OAUTH_CLIENT_SECRET=your-slack-client-secret
