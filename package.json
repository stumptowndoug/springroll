{
  "name": "shrimp-roll",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "kernel",
    "app",
    "cli"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "dev:cli": "bun run --cwd cli dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --build --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
