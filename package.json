{
  "name": "springroll",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "kernel",
    "app",
    "cli",
    "spikes/rivet-r0"
  ],
  "scripts": {
    "build": "bun run --cwd app build",
    "build:mac": "bun desktop/package.ts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "dev:mac": "bun desktop/dev.ts",
    "dev:app": "bun --env-file=../.env run --cwd app dev",
    "dev:cli": "bun run --cwd cli dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "bun test",
    "typecheck": "tsc --build --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
