#!/usr/bin/env bash
# Put something on the owner's Home page (Needs you / Worth knowing). See AGENTS.md, "Home".
#   signal "Title" ["detail"]            worth knowing (shown for 3 days)
#   signal --needs "Title" ["detail"]    waiting on the owner (pings their phone once, when it's new)
#   signal --running --key K "Title" "progress"   long work outside a job run, in the Timeline's
#                                        Running section; post again to update, --clear K when done
#   signal --brief "Two or three sentences"   today's morning brief
#   signal --clear <key>                 take one back
#   signal sync <prefix> [--source S] [--icon I] [--needs]   < items (JSON array or one JSON object per line)
#        a connector's whole current list: each item {key, title, body, href, note, rev, icon, level};
#        keys start with <prefix>; items under <prefix> not in the list come off Home
#   signal list [prefix]                 what's showing now
# Options: --key K (same key replaces it), --link/--url L ('#/route' or https://…), --source "Name",
#          --icon lucide-name, --note "what an agent needs to act on it", --rev R (changes upstream
#          bring a done item back), --hours N (expiry), --quiet (no phone ping).
# Run from a chat or job, a signal links back to it and is named after it.
set -euo pipefail
API=localhost:8090

if [ "${1:-}" = list ]; then
  curl -sS --fail-with-body "$API/signals" | jq -r --arg p "${2:-}" '.[] | select(.key // "" | startswith($p)) | "\(.level)\t\(.key // "-")\t\(.title)"'
  exit 0
fi

if [ "${1:-}" = sync ]; then
  shift
  prefix=${1:-}; [ -n "$prefix" ] || { echo 'usage: signal sync <prefix> [--source S] [--icon I] [--needs] < items.json' >&2; exit 1; }
  shift
  source= icon= level=
  while [ $# -gt 0 ]; do
    case "$1" in
      --source) source=$2; shift ;;
      --icon) icon=$2; shift ;;
      --needs) level=needs ;;
      --notable) level=notable ;;
      *) echo "signal sync: unknown option $1" >&2; exit 1 ;;
    esac
    shift
  done
  # A JSON array or JSON lines on stdin; an empty stdin means "nothing open any more".
  items=$(jq -cs 'if length == 1 and (.[0] | type) == "array" then .[0] else . end')
  curl -sS --fail-with-body -X POST "$API/signals/sync" -H 'content-type: application/json' -d "$(jq -n \
    --arg prefix "$prefix" --arg source "$source" --arg icon "$icon" --arg level "$level" --argjson items "$items" \
    '{prefix: $prefix, items: $items} + ({source: $source, icon: $icon, level: $level} | with_entries(select(.value != "")))')"
  echo
  exit 0
fi

level=notable key= link= source= hours= quiet= icon= note= rev= args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --needs) level=needs ;;
    --brief) level=brief ;;
    --running) level=running ;;
    --key) key=$2; shift ;;
    --link|--url) link=$2; shift ;;
    --source) source=$2; shift ;;
    --icon) icon=$2; shift ;;
    --note) note=$2; shift ;;
    --rev) rev=$2; shift ;;
    --hours) hours=$2; shift ;;
    --quiet) quiet=1 ;;
    --clear)
      [ $# -ge 2 ] || { echo "usage: signal --clear <key>" >&2; exit 1; }
      curl -sS --fail-with-body -X POST "$API/signals/clear" -H 'content-type: application/json' -d "$(jq -n --arg k "$2" '{key: $k}')"
      echo; exit 0 ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; args+=("$@"); break ;;
    -*) echo "signal: unknown option $1" >&2; exit 1 ;;
    *) args+=("$1") ;;
  esac
  shift
done
set -- ${args[@]+"${args[@]}"}
[ $# -ge 1 ] || { echo 'usage: signal [--needs|--brief] [--key K] [--link L] "Title" ["detail"]  (signal --help)' >&2; exit 1; }
title=$1 body=${2:-}
[ "$level" = brief ] && [ -z "$body" ] && { body=$title; title="Morning brief"; }
curl -sS --fail-with-body -X POST "$API/signals" -H 'content-type: application/json' -d "$(jq -n \
  --arg level "$level" --arg title "$title" --arg body "$body" --arg key "$key" --arg href "$link" \
  --arg source "$source" --arg icon "$icon" --arg note "$note" --arg rev "$rev" --arg hours "$hours" --arg quiet "$quiet" \
  --arg thread "${SPRINGROLL_THREAD:-${AGENTOS_THREAD:-}}" \
  '{level: $level, title: $title} + ({body: $body, key: $key, href: $href, source: $source, icon: $icon, note: $note, rev: $rev, thread: $thread} | with_entries(select(.value != "")))
   + (if $hours != "" then {hours: ($hours | tonumber)} else {} end) + (if $quiet != "" then {notify: false} else {} end)')"
echo
