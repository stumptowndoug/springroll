#!/usr/bin/env bash
# Restore a backup made by `backup` onto this machine:
#   restore <file.tar.gz> [--force]
#   restore --offsite <repository> [snapshot]   from the bucket (restic), the latest snapshot by default:
#        credentials as for restic (or BACKUP_* keys in ~/.config/springroll/secrets.env), the
#        passphrase as below; see skills/backup/SKILL.md
# Replaces ~/home (keeping the current one as ~/home.before-restore-<date>),
# restores ~/data, and decrypts secrets with ~/.config/springroll/backup-passphrase
# (or $SPRINGROLL_BACKUP_PASSPHRASE). Restarts Springroll afterwards.
set -euo pipefail
FILE=${1:?usage: restore <backup.tar.gz> | restore --offsite <repository> [snapshot]}
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT
PASSFILE=~/.config/springroll/backup-passphrase
: "${SPRINGROLL_BACKUP_PASSPHRASE:=${AGENTOS_BACKUP_PASSPHRASE:-}}" # the old name still works
if [ "$FILE" = --offsite ]; then
  REPO=${2:?usage: restore --offsite <repository> [snapshot]}
  command -v restic >/dev/null || sudo apt-get install -y -qq restic >/dev/null
  if [ -f ~/.config/springroll/secrets.env ]; then set -a; . ~/.config/springroll/secrets.env; set +a; fi
  for v in AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION B2_ACCOUNT_ID B2_ACCOUNT_KEY AZURE_ACCOUNT_NAME AZURE_ACCOUNT_KEY AZURE_ACCOUNT_SAS GOOGLE_PROJECT_ID; do
    b="BACKUP_$v"; [ -n "${!b:-}" ] && export "$v=${!b}"
  done
  if [ -n "${BACKUP_GCS_CREDENTIALS:-}" ] && [ -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]; then
    printf %s "$BACKUP_GCS_CREDENTIALS" > "$STAGE/gcs.json"; export GOOGLE_APPLICATION_CREDENTIALS="$STAGE/gcs.json"
  fi
  if [ -z "${SPRINGROLL_BACKUP_PASSPHRASE:-}" ] && [ ! -s "$PASSFILE" ] && [ -t 0 ]; then read -rsp "Backup passphrase: " SPRINGROLL_BACKUP_PASSPHRASE; echo; fi
  if [ -n "${SPRINGROLL_BACKUP_PASSPHRASE:-}" ]; then export RESTIC_PASSWORD="$SPRINGROLL_BACKUP_PASSPHRASE"; else export RESTIC_PASSWORD_FILE="$PASSFILE"; fi
  restic -r "$REPO" restore "${3:-latest}" --target "$STAGE/r" -q
  SRC=$(dirname "$(find "$STAGE/r" -name home.bundle -print -quit)")
else
  [ -f "$FILE" ] || { echo "no such file: $FILE" >&2; exit 1; }
  tar -C "$STAGE" -xzf "$FILE"
  SRC=$(find "$STAGE" -mindepth 1 -maxdepth 1 -type d | head -1)
fi
[ -f "$SRC/home.bundle" ] || { echo "not a Springroll backup" >&2; exit 1; }
echo "Restoring $(jq -r '.host + " from " + .created' "$SRC/manifest.json")"
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
systemctl --user stop agentd desk desk-term >/dev/null 2>&1 || true
for f in ~/home/views/*/*.service ~/home/views/*/*.timer; do [ -e "$f" ] && systemctl --user disable --now "$(basename "$f")" >/dev/null 2>&1 || true; done

STAMP=$(date +%Y%m%d-%H%M%S)
[ -d ~/home ] && mv ~/home ~/home.before-restore-$STAMP
git clone -q "$SRC/home.bundle" ~/home
git -C ~/home remote remove origin 2>/dev/null || true

mkdir -p ~/data
if [ -d "$SRC/data" ]; then
  # A restored database must not meet the old one's write-ahead log.
  (cd "$SRC/data" && find . -type f) | while read -r f; do rm -f ~/data/"$f"-wal ~/data/"$f"-shm ~/data/"$f"-journal; done
  cp -a "$SRC/data/." ~/data/
fi

if [ -d "$SRC/secrets" ]; then # from the bucket: restic already decrypted them
  cp -a "$SRC/secrets/." ~/ && echo "Secrets restored"
elif [ -f "$SRC/secrets.tar.gz.enc" ]; then
  if [ -n "${SPRINGROLL_BACKUP_PASSPHRASE:-}" ]; then PASSARG="env:SPRINGROLL_BACKUP_PASSPHRASE"
  elif [ -s "$PASSFILE" ]; then PASSARG="file:$PASSFILE"
  elif [ -t 0 ]; then read -rsp "Backup passphrase: " SPRINGROLL_BACKUP_PASSPHRASE; echo; export SPRINGROLL_BACKUP_PASSPHRASE; PASSARG="env:SPRINGROLL_BACKUP_PASSPHRASE"
  else PASSARG=""; echo "Secrets not restored: no passphrase (set SPRINGROLL_BACKUP_PASSPHRASE)"; fi
  [ -n "$PASSARG" ] && { openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -pass "$PASSARG" -in "$SRC/secrets.tar.gz.enc" | tar -C ~ -xzf - && echo "Secrets restored" || echo "Secrets not restored: wrong passphrase?"; }
fi
# Backups from before the rename keep secrets in ~/.config/agentos: move them over, keeping this
# machine's own env and seed files.
if [ -d ~/.config/agentos ] && [ ! -L ~/.config/agentos ]; then
  mkdir -p ~/.config/springroll
  for f in ~/.config/agentos/* ~/.config/agentos/.[!.]*; do
    [ -e "$f" ] || continue
    case "$(basename "$f")" in env|seed) [ -e ~/.config/springroll/"$(basename "$f")" ] && continue ;; esac
    cp -a "$f" ~/.config/springroll/
  done
  rm -rf ~/.config/agentos && ln -s springroll ~/.config/agentos
fi

# Re-link services from the restored home.
mkdir -p ~/.config/systemd/user
for u in ~/home/views/desk/desk.service ~/home/views/desk/desk-term.service ~/home/agentd/agentd.service ~/home/views/*/*.service ~/home/views/*/*.timer; do
  [ -e "$u" ] || continue
  systemctl --user link "$u" >/dev/null 2>&1 || true
done
systemctl --user daemon-reload
for u in ~/home/views/*/*.service ~/home/views/*/*.timer ~/home/agentd/agentd.service; do
  [ -e "$u" ] && grep -q '^\[Install\]' "$u" && systemctl --user enable --now "$(basename "$u")" >/dev/null 2>&1 || true
done
systemctl --user restart desk desk-term agentd
echo "Restored. The previous ~/home is at ~/home.before-restore-$STAMP"
