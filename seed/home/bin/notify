#!/usr/bin/env bash
# Push a notification to the owner's phone (ntfy) and Springroll: notify "<text>"
set -euo pipefail
[ $# -ge 1 ] || { echo "usage: notify <text>" >&2; exit 1; }
msg="$*"
# A copy of Springroll (`change up`, SPRINGROLL_COPY) shows it on its own screen, never on the phone.
if [ -z "${SPRINGROLL_COPY:-}" ]; then
  topic=$(cat "$HOME/.config/springroll/ntfy-topic")
  curl -fsS -o /dev/null -d "$msg" "https://ntfy.sh/$topic"
fi
curl -fsS -o /dev/null -X POST localhost:${SPRINGROLL_PORT:-8000}/api/notify -H 'content-type: application/json' \
  -d "$(jq -n --arg t "$msg" '{text: $t}')" || true
echo sent
