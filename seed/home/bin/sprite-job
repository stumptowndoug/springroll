#!/usr/bin/env bash
# Long-running work on a Sprite (Fly.io cloud computer), driven from this box.
# A plain `sprite exec` stops when the Sprite pauses; jobs started here hold it
# awake until they finish (see sprite-run). Needs the Fly Sprites connection.
#   sprite-job start  <sprite> <name> [--dir DIR] -- <command...>   start detached
#   sprite-job status <sprite> [name]                               one job, or all
#   sprite-job logs   <sprite> <name> [lines]                       tail its log
#   sprite-job wait   <sprite> <name> [timeout-minutes]             block until done; exits with its code
#   sprite-job stop   <sprite> <name>                               kill it
set -euo pipefail
cmd=${1:-}; sprite=${2:-}
[ -n "$cmd" ] && [ -n "$sprite" ] || { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
command -v sprite >/dev/null || { echo "sprite CLI missing: connect Fly Sprites in the Desk (Connections)" >&2; exit 1; }
x() { sprite exec -s "$sprite" -- bash -lc "$1"; }

case "$cmd" in
  start)
    name=${3:?name}; shift 3
    dir=""
    if [ "${1:-}" = --dir ]; then dir=$2; shift 2; fi
    [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || { echo "nothing to run" >&2; exit 2; }
    run="$*"; [ -n "$dir" ] && run="cd $dir && $run"
    sprite exec -s "$sprite" --file "$(dirname "$0")/sprite-run:/tmp/sprite-run" -- \
      bash -lc 'mkdir -p ~/.agentos && install -m 755 /tmp/sprite-run ~/.agentos/sprite-run'
    x "$(printf '~/.agentos/sprite-run %q %q' "$name" "$run")"
    ;;
  status)
    name=${3:-}
    x "cd ~/.agentos/runs 2>/dev/null || { echo 'No jobs yet.'; exit 0; }
       for d in ${name:-*}; do [ -d \"\$d\" ] || continue
         s=\$(cat \$d/status 2>/dev/null); e=\$(cat \$d/exit 2>/dev/null); st=\$(cat \$d/started 2>/dev/null); fi=\$(cat \$d/finished 2>/dev/null || date +%s)
         if [ \"\$s\" = running ] && ! kill -0 \$(cat \$d/pid 2>/dev/null) 2>/dev/null; then s='lost (the Sprite restarted?)'; fi
         printf '%-24s %-10s exit=%-4s %5ss  %s\n' \"\$d\" \"\$s\" \"\${e:--}\" \"\$(( fi - \${st:-fi} ))\" \"\$(cat \$d/command 2>/dev/null | cut -c1-80)\"
       done"
    ;;
  logs)
    name=${3:?name}; n=${4:-60}
    x "tail -n $n ~/.agentos/runs/$name/log"
    ;;
  wait)
    name=${3:?name}; limit=$(( ${4:-720} * 60 )); waited=0
    while :; do
      s=$(x "cat ~/.agentos/runs/$name/status 2>/dev/null" || true)
      [ "$s" = done ] && break
      [ "$waited" -ge "$limit" ] && { echo "still running after $((limit / 60)) min" >&2; exit 124; }
      sleep 60; waited=$((waited + 60))
    done
    code=$(x "cat ~/.agentos/runs/$name/exit")
    echo "$name finished with exit $code"; exit "$code"
    ;;
  stop)
    name=${3:?name}
    x "pkill -TERM -s \$(cat ~/.agentos/runs/$name/pid) 2>/dev/null; echo stopped > ~/.agentos/runs/$name/status; echo 'stopped $name'"
    ;;
  *) echo "unknown command: $cmd" >&2; exit 2 ;;
esac
