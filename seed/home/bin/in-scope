#!/usr/bin/env bash
# Run a command in its own systemd scope so the System View can measure it,
# the kernel can cap it, and it's killed before the Desk if memory runs out:
#   in-scope <name> <command...>
# Falls back to running the command directly if the user manager isn't reachable.
name=$1; shift
# Killed before the Desk under memory pressure (raising this needs no privileges).
echo 500 > /proc/self/oom_score_adj 2>/dev/null
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
total_mb=$(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo)
if systemctl --user show-environment >/dev/null 2>&1; then
  exec systemd-run --user --scope --quiet --collect --unit="agent-$name-$(date +%s)" \
    -p MemoryHigh=$((total_mb * 60 / 100))M -- "$@"
fi
exec "$@"
