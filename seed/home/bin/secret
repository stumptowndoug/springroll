#!/usr/bin/env bash
# The owner's keys (Springroll → Connections → Keys). Never ask the owner to paste a key into chat.
#   secret request NAME "what it's for"   ask the owner: a card on Home where they paste it; you're
#                                         told in this chat when it's saved
#   secret get NAME                       print it, for inline use only: curl -H "x-key: $(secret get NAME)"
#   secret list                           names only
#   secret has NAME                       exit 0 if it's set
#   printf %s "$value" | secret set NAME ["note"]   save a key you generated (not one the owner has)
# New sessions get every key as an environment variable ($NAME); a running session doesn't, so use
# "$(secret get NAME)" there. Don't echo, print or write a key anywhere.
set -euo pipefail
FILE="$HOME/.config/springroll/secrets.env"
cmd=${1:-}; name=${2:-}
value_of() { [ -f "$FILE" ] && sed -n "s/^$1='\(.*\)'\$/\1/p" "$FILE" | sed "s/'\\\\''/'/g" | head -1; }
need_name() { [[ "$name" =~ ^[A-Z_][A-Z0-9_]{0,63}$ ]] || { echo "secret: give a NAME like OPENAI_API_KEY" >&2; exit 1; }; }
case "$cmd" in
  get) need_name; v=$(value_of "$name"); [ -n "$v" ] || { echo "secret: $name isn't set (ask: secret request $name \"why\")" >&2; exit 1; }; printf %s "$v" ;;
  has) need_name; [ -n "$(value_of "$name")" ] ;;
  list) [ -f "$FILE" ] && sed -n "s/^\([A-Z_][A-Z0-9_]*\)=.*/\1/p" "$FILE" | sort ;;
  request)
    need_name
    if [ -n "$(value_of "$name")" ]; then echo "$name is already set: use \"\$(secret get $name)\""; exit 0; fi
    signal --needs --key "secret:$name" "Add the key $name" "${3:-An agent needs it.}" >/dev/null
    echo "Asked the owner for $name on Home. You'll get a message in this chat when it's saved; don't wait for it in a loop." ;;
  set)
    need_name; v=$(cat); [ -n "$v" ] || { echo "secret: pipe the value in" >&2; exit 1; }
    curl -fsS -X POST localhost:8000/api/secrets -H 'content-type: application/json' \
      -d "$(jq -n --arg n "$name" --arg v "$v" --arg note "${3:-}" '{name: $n, value: $v} + (if $note != "" then {note: $note} else {} end)')" >/dev/null
    echo "Saved $name." ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; [ -z "$cmd" ] || exit 1 ;;
esac
