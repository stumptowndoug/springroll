#!/usr/bin/env python3
"""Antigravity's chat runtime: Google's official ACP server (agy_acp_server), separate from the agy CLI.

  agy-acp-install            download, verify and install it (pinned version, SHA-256 checked)
  agy-acp-install --remove   remove it
  agy-acp-install --signin   sign the runtime in with Google (once; it doesn't use agy's login)

Installs to ~/.local/share/springroll/agy-acp/<version>-<arch>/ and puts `agy-acp-server` (what chat runs,
agents/agents.json "acp") in ~/.local/bin. Pins come from Google's versioned downloads listed in the ACP
registry (github.com/agentclientprotocol/registry, antigravity-acp/agent.json); Google publishes no
checksums. To move to a new version: download each archive from the registry's URLs, check its entries,
and update VERSION and every hash together. Never pin a hash fetched alongside the download.

Sign-in: Google sends the browser back to http://127.0.0.1:<port>/ on this machine, which the owner's
browser (on another device) can't reach. So the owner pastes that address here and this fetches it
locally, which completes the sign-in. Then auth.type is saved in the runtime's settings.json, so chats
start without signing in again.
"""
import atexit, hashlib, json, os, platform, queue, re, shutil, signal, subprocess, sys, threading, time, urllib.parse, urllib.request, zipfile

VERSION = '1.3.0'
FILES = ['agy_acp_server.par', 'localharness_external']
PINS = {  # arch: (archive url, archive sha256, {file: sha256})
    'x86_64': ('https://dl.google.com/agy-extensions/releases/linux/agy-acp-server-1.3.0-linux-x86_64.zip',
               '9fb60956af0a9d76220a4db91ca9ac88e2a2372ad68f985ab5fceace6b825b96',
               {'agy_acp_server.par': 'cf6feaebdacfc2255dcfc8883db99b15de8554698554e2a1e78e5ccec1c68a20',
                'localharness_external': '63042ca43fc7a69600683920f7706689b82cf8aecefe21dc18cf35e99c9dde4d'}),
    'arm64': ('https://dl.google.com/agy-extensions/releases/linux/agy-acp-server-1.3.0-linux-arm64.zip',
              '500b0bc0fb858e88f4df404d4cedf80bf9298c178291e39e383d6c50b111cbdf',
              {'agy_acp_server.par': '03ea51ff7a60cb1b44e65da40fdb35f1f457db7950d1651d9e86945c8aa584c6',
               'localharness_external': '7fe676f1234889900800bad3ca50fb9b55f1e16ee4cb82b789f84ae5145fd582'}),
}
HOME = os.path.expanduser('~')
ARCH = {'aarch64': 'arm64', 'arm64': 'arm64'}.get(platform.machine(), platform.machine())
BASE = os.path.join(HOME, '.local/share/springroll/agy-acp')
DIR = os.path.join(BASE, f'{VERSION}-{ARCH}')
LAUNCHER = os.path.join(HOME, '.local/bin/agy-acp-server')
SETTINGS = os.path.join(HOME, '.gemini/antigravity-acp/settings.json')
AUTH_LINE = 'Open the following link to authenticate the ACP server:'


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for b in iter(lambda: f.read(1 << 20), b''):
            h.update(b)
    return h.hexdigest()


def install():
    if sys.platform != 'linux' or ARCH not in PINS:
        die(f'No verified Antigravity chat runtime for {sys.platform} {ARCH} yet.')
    url, archive_sha, file_shas = PINS[ARCH]
    if all(os.path.isfile(os.path.join(DIR, f)) and sha256(os.path.join(DIR, f)) == file_shas[f] for f in FILES):
        write_launcher()
        print(f'Antigravity chat runtime {VERSION} is already installed.')
        return
    os.makedirs(BASE, exist_ok=True)
    stage = os.path.join(BASE, f'.install-{os.getpid()}')
    shutil.rmtree(stage, ignore_errors=True)
    os.makedirs(stage)
    try:
        archive = os.path.join(stage, 'runtime.zip')
        print(f'Downloading Antigravity chat runtime {VERSION} from Google (about 330 MB)…', flush=True)
        r = subprocess.run(['curl', '--fail', '--location', '--silent', '--show-error', '--proto', '=https', '--proto-redir', '=https',
                            '--connect-timeout', '15', '--max-time', '900', '--max-filesize', '600000000', '-o', archive, url])
        if r.returncode:
            die("Couldn't download the Antigravity chat runtime. Check the connection and try again.")
        print('Checking the download…', flush=True)
        if sha256(archive) != archive_sha:
            die('The download failed its integrity check, so it was not installed.')
        z = zipfile.ZipFile(archive)
        if sorted(z.namelist()) != sorted(FILES):
            die('The download has unexpected contents, so it was not installed.')
        print('Unpacking (about 1 GB)…', flush=True)
        for name in FILES:  # exact entries only; paths and modes in the zip aren't trusted
            out = os.path.join(stage, name)
            with z.open(name) as src, open(out, 'wb') as dst:
                shutil.copyfileobj(src, dst, 1 << 20)
            os.chmod(out, 0o700)
            if sha256(out) != file_shas[name]:
                die(f"{name} failed its integrity check, so it was not installed.")
        os.remove(archive)
        old = DIR + f'.old-{os.getpid()}'
        if os.path.exists(DIR):
            os.rename(DIR, old)
        os.rename(stage, DIR)
        shutil.rmtree(old, ignore_errors=True)
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    # Older versions: gone once this one is in place.
    for d in os.listdir(BASE):
        if d != os.path.basename(DIR) and not d.startswith('.'):
            shutil.rmtree(os.path.join(BASE, d), ignore_errors=True)
    write_launcher()
    print(f'Installed the Antigravity chat runtime {VERSION}.')


def write_launcher():
    os.makedirs(os.path.dirname(LAUNCHER), exist_ok=True)
    with open(LAUNCHER, 'w') as f:  # the registry's Linux command line: --uid= with no value
        f.write(f'#!/bin/sh\n# Antigravity chat runtime (installed by agy-acp-install)\nexec "{DIR}/agy_acp_server.par" --uid= "$@"\n')
    os.chmod(LAUNCHER, 0o755)


def remove():
    shutil.rmtree(BASE, ignore_errors=True)
    if os.path.exists(LAUNCHER):
        os.remove(LAUNCHER)
    print('Removed the Antigravity chat runtime. Its Google sign-in is kept for if you add it again.')


def signin():
    if not os.path.exists(LAUNCHER):
        install()
    p = subprocess.Popen([LAUNCHER], cwd=HOME, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1, start_new_session=True)
    # Cancelled (the sign-in panel closes its terminal) or done: stop the runtime and its helper.
    atexit.register(lambda: os.killpg(p.pid, signal.SIGTERM) if p.poll() is None else None)
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda *_: sys.exit(1))
    lines = queue.Queue()
    for stream in (p.stdout, p.stderr):
        threading.Thread(target=lambda s=stream: [lines.put(l) for l in s], daemon=True).start()
    send = lambda id, method, params: (p.stdin.write(json.dumps({'jsonrpc': '2.0', 'id': id, 'method': method, 'params': params}) + '\n'), p.stdin.flush())
    send(1, 'initialize', {'protocolVersion': 1, 'clientCapabilities': {}, 'clientInfo': {'name': 'springroll', 'version': '0.1'}})
    send(2, 'authenticate', {'methodId': 'oauth-personal'})
    print('Starting Google sign-in…', flush=True)
    link, port, deadline = None, None, time.time() + 900
    pasted = queue.Queue()
    while time.time() < deadline:
        try:
            line = lines.get(timeout=0.5)
        except queue.Empty:
            if p.poll() is not None:
                die("The Antigravity chat runtime stopped before the sign-in finished.")
            if not pasted.empty():
                finish(pasted.get(), port)
            continue
        if line.startswith('{'):
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if msg.get('id') == 2:
                if msg.get('error'):
                    die(f"Google sign-in didn't finish: {msg['error'].get('message', 'unknown error')}")
                save_auth()
                print('Signed in. Antigravity chats are ready.', flush=True)
                return
        elif AUTH_LINE in line and not link:
            link = line.split(AUTH_LINE, 1)[1].strip()
            u = urllib.parse.urlparse(link)
            if u.scheme != 'https' or u.hostname != 'accounts.google.com':
                die('The runtime asked for an unexpected sign-in page; stopping.')
            redirect = urllib.parse.urlparse(urllib.parse.parse_qs(u.query).get('redirect_uri', [''])[0])
            port = redirect.port
            print(f'Open this page to sign in:\n  {link}\n', flush=True)
            print("After you approve, Google sends you to a 127.0.0.1 page that won't load. That's expected:", flush=True)
            print('copy that page\'s address from the address bar and paste it here.', flush=True)
            threading.Thread(target=lambda: [pasted.put(l.strip()) for l in sys.stdin], daemon=True).start()
    die('The sign-in timed out. Try again.')


def finish(address, port):
    """Fetch the pasted 127.0.0.1 redirect here, where the runtime is listening, which completes the sign-in."""
    u = urllib.parse.urlparse(address)
    if u.scheme != 'http' or u.hostname not in ('127.0.0.1', 'localhost') or u.port != port or 'code=' not in u.query:
        print(f"That isn't the address of the 127.0.0.1:{port} page Google sent you to. Paste the whole address from the address bar.", flush=True)
        return
    try:
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        opener.open(f'http://127.0.0.1:{port}{u.path or "/"}?{u.query}', timeout=30).read()
        print('Finishing sign-in…', flush=True)
    except Exception as e:
        print(f"Couldn't finish with that address ({e}). Try signing in again if it keeps failing.", flush=True)


def save_auth():
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    s = {}
    try:
        with open(SETTINGS) as f:
            s = json.load(f)
    except (OSError, ValueError):
        pass
    s['auth'] = {**(s.get('auth') or {}), 'type': 'oauth-personal'}
    with open(SETTINGS, 'w') as f:
        json.dump(s, f, indent=2)
    os.chmod(SETTINGS, 0o600)


if __name__ == '__main__':
    arg = sys.argv[1] if len(sys.argv) > 1 else ''
    {'': install, '--remove': remove, '--signin': signin}.get(arg, lambda: die(__doc__))()
