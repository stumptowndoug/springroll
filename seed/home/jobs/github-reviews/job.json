{
  "title": "GitHub reviews",
  "group": "Inbox",
  "type": "command",
  "schedule": "*/15 * * * *",
  "onlyIf": "gh auth status >/dev/null 2>&1",
  "cwd": "~/home",
  "command": "bash ~/home/jobs/github-reviews/sync.sh",
  "keep": "failures",
  "enabled": true,
  "catchUp": "skip",
  "notify": true,
  "report": true,
  "timeline": "failures"
}
