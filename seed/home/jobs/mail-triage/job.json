{
  "title": "Mail triage",
  "group": "Inbox",
  "type": "command",
  "schedule": "*/15 * * * *",
  "onlyIf": "test \"$(curl -s \"localhost:$(cat ~/home/views/mail/PORT)/api/triage/pending?limit=1\" | jq '.items | length')\" -gt 0",
  "command": "uv run -q --script ~/home/jobs/mail-triage/triage.py",
  "model": "claude-haiku-5-5",
  "keep": "failures",
  "timeout": "10m",
  "retries": 1,
  "retryDelay": "5m",
  "enabled": false,
  "catchUp": "skip",
  "notify": false,
  "timeline": "failures"
}
