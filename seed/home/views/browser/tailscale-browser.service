[Unit]
Description=Browser app: Tailscale for the browser only (exits through the owner's home node)
# Optional: runs only once Home internet is set up in the Browser app (which creates this folder).
ConditionPathExists=%h/.config/springroll/tailscale-browser

[Service]
# Userspace mode: no tun device or root, nothing else on this machine is routed. The browser
# reaches the internet through its SOCKS5 proxy; with an exit node set, traffic leaves from home.
ExecStart=/usr/sbin/tailscaled --tun=userspace-networking --socks5-server=127.0.0.1:1055 \
  --statedir=%h/.config/springroll/tailscale-browser --socket=%t/tailscale-browser.sock --port=0
Restart=always
RestartSec=5
MemoryHigh=150M
MemoryMax=250M
OOMScoreAdjust=300

[Install]
WantedBy=default.target
