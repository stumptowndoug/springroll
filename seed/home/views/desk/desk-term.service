[Unit]
Description=Desk: web terminal attached to the agent's tmux session

[Service]
ExecStart=ttyd -i 127.0.0.1 -p 7681 -b /term -W -a -t fontSize=14 -t "theme={\"background\":\"#16171a\"}" %h/home/bin/agent-session
Restart=always
RestartSec=2
# Restarting the terminal server must not kill the agent's tmux session.
KillMode=process

[Install]
WantedBy=default.target
