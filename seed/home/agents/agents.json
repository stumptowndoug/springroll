[
  {
    "id": "claude",
    "name": "Claude Code",
    "maker": "Anthropic",
    "plan": "Your Claude plan",
    "bin": "claude",
    "acp": [
      "claude-agent-acp"
    ],
    "acpInstall": "updates install chat:claude",
    "install": "curl -fsSL https://claude.ai/install.sh | bash",
    "login": "claude setup-token  # or run claude and use /login",
    "fullLogin": "env -u CLAUDE_CODE_OAUTH_TOKEN claude auth login",
    "auth": [
      "~/.config/springroll/claude-token",
      "~/.claude/.credentials.json"
    ],
    "account": "m=$([ -s ~/.config/springroll/claude-token ] && echo \"Setup token\" || echo \"Claude.ai sign-in\"); env -u CLAUDE_CODE_OAUTH_TOKEN claude auth status 2>/dev/null | jq -c --arg m \"$m\" '{account: .email, plan: .subscriptionType, method: $m}'",
    "start": "claude --dangerously-skip-permissions",
    "continue": "claude --dangerously-skip-permissions --continue",
    "startWithPrompt": "claude --dangerously-skip-permissions {prompt}",
    "headless": "claude -p \"<prompt>\" --dangerously-skip-permissions",
    "headlessContinue": "claude -p --continue \"<feedback>\"",
    "notes": "Subscription via setup token. Reads CLAUDE.md (which includes AGENTS.md).",
    "waitingPattern": "Do you want to proceed\\?|Do you want to (make|create|allow)|❯ 1\\. Yes",
    "headlessArgv": [
      "claude",
      "-p",
      "{prompt}",
      "--dangerously-skip-permissions"
    ],
    "signin": {
      "command": "env -u CLAUDE_CODE_OAUTH_TOKEN claude auth login",
      "kind": "paste"
    },
    "size": {
      "cli": 245,
      "chat": 307
    },
    "disk": {
      "cli": [
        "~/.local/share/claude"
      ],
      "chat": [
        "~/.local/share/springroll/chat/claude"
      ]
    },
    "acpRemove": "updates remove chat:claude",
    "acpPackage": "@agentclientprotocol/claude-agent-acp"
  },
  {
    "id": "codex",
    "name": "Codex",
    "maker": "OpenAI",
    "plan": "Your ChatGPT plan",
    "bin": "codex",
    "acp": [
      "codex-acp"
    ],
    "acpInstall": "updates install chat:codex",
    "install": "npm i -g @openai/codex",
    "login": "codex login --device-auth",
    "auth": [
      "~/.codex/auth.json"
    ],
    "account": "jq -c '(.tokens.id_token // \"\" | try (split(\".\")[1] | @base64d | fromjson) catch {}) as $t | {account: $t.email, plan: $t[\"https://api.openai.com/auth\"].chatgpt_plan_type, method: (if .auth_mode == \"chatgpt\" then \"ChatGPT sign-in\" else \"API key\" end)}' ~/.codex/auth.json",
    "start": "codex --dangerously-bypass-approvals-and-sandbox",
    "continue": "codex resume --last --dangerously-bypass-approvals-and-sandbox",
    "startWithPrompt": "codex --dangerously-bypass-approvals-and-sandbox {prompt}",
    "headless": "codex exec --dangerously-bypass-approvals-and-sandbox -C <dir> - < spec.md",
    "headlessContinue": "codex exec resume --last \"<feedback>\"",
    "notes": "ChatGPT subscription via device login. Reads AGENTS.md.",
    "waitingPattern": "Allow command\\?|Approve|\\[y/N\\]|Press enter to continue",
    "headlessArgv": [
      "codex",
      "exec",
      "--dangerously-bypass-approvals-and-sandbox",
      "{prompt}"
    ],
    "signin": {
      "command": "codex login --device-auth",
      "kind": "device"
    },
    "size": {
      "cli": 432,
      "chat": 442
    },
    "disk": {
      "cli": [
        "npm:@openai/codex"
      ],
      "chat": [
        "~/.local/share/springroll/chat/codex"
      ]
    },
    "acpRemove": "updates remove chat:codex",
    "acpPackage": "@agentclientprotocol/codex-acp",
    "acpLegacy": [
      "@zed-industries/codex-acp"
    ]
  },
  {
    "id": "opencode",
    "name": "OpenCode",
    "maker": "SST",
    "plan": "Any provider, with your own keys",
    "bin": "opencode",
    "acp": [
      "opencode",
      "acp"
    ],
    "install": "npm i -g opencode-ai",
    "login": "opencode auth login",
    "auth": [
      "~/.local/share/opencode/auth.json"
    ],
    "account": "jq -c '{method: ((keys | map({openrouter: \"OpenRouter\", anthropic: \"Anthropic\", openai: \"OpenAI\", google: \"Google\", opencode: \"OpenCode Zen\", groq: \"Groq\", deepseek: \"DeepSeek\", mistral: \"Mistral\", xai: \"xAI\"}[.] // .) | join(\", \")) + \" API key\")}' ~/.local/share/opencode/auth.json",
    "providerAuth": {
      "auth": [
        "~/.local/share/opencode/auth.json"
      ],
      "config": [
        "~/.config/opencode/opencode.json"
      ]
    },
    "preferModels": [
      "claude-sonnet",
      "gpt-5",
      "gemini-3-pro"
    ],
    "start": "opencode",
    "continue": "opencode --continue",
    "startWithPrompt": "opencode --prompt {prompt}",
    "headless": "opencode run \"<prompt>\"",
    "headlessContinue": "opencode run -c \"<feedback>\"",
    "notes": "Any provider (API keys or subscriptions). Reads AGENTS.md.",
    "waitingPattern": "Allow|Permission required|\\[y/n\\]",
    "headlessArgv": [
      "opencode",
      "run",
      "{prompt}"
    ],
    "size": {
      "cli": 355,
      "chat": 0
    },
    "disk": {
      "cli": [
        "npm:opencode-ai"
      ]
    }
  },
  {
    "id": "pi",
    "name": "Pi",
    "maker": "Mario Zechner",
    "plan": "Any provider, with your own keys",
    "bin": "pi",
    "acp": [
      "pi-acp"
    ],
    "acpInstall": "updates install chat:pi",
    "install": "npm rm -g @mariozechner/pi-coding-agent >/dev/null 2>&1; npm i -g @earendil-works/pi-coding-agent",
    "login": "pi  # then /login, or set a provider API key",
    "auth": [
      "~/.pi/agent/auth.json"
    ],
    "account": "jq -c '{method: ((keys | map({openrouter: \"OpenRouter\", anthropic: \"Anthropic\", openai: \"OpenAI\", google: \"Google\", opencode: \"OpenCode Zen\", groq: \"Groq\", deepseek: \"DeepSeek\", mistral: \"Mistral\", xai: \"xAI\"}[.] // .) | join(\", \")) + \" API key\")}' ~/.pi/agent/auth.json",
    "start": "pi",
    "continue": "pi --continue",
    "startWithPrompt": "pi {prompt}",
    "headless": "pi -p \"<prompt>\"",
    "headlessContinue": "pi -p -c \"<feedback>\"",
    "notes": "Minimal, any provider; no approval layer. API keys bill per token.",
    "waitingPattern": "\\[y/n\\]|Continue\\?",
    "headlessArgv": [
      "pi",
      "-p",
      "{prompt}"
    ],
    "size": {
      "cli": 166,
      "chat": 7
    },
    "disk": {
      "cli": [
        "npm:@earendil-works/pi-coding-agent"
      ],
      "chat": [
        "~/.local/share/springroll/chat/pi"
      ]
    },
    "acpRemove": "updates remove chat:pi",
    "acpPackage": "pi-acp"
  },
  {
    "id": "cursor",
    "name": "Cursor",
    "maker": "Anysphere",
    "plan": "Your Cursor plan",
    "bin": "cursor-agent",
    "install": "curl https://cursor.com/install -fsS | bash",
    "login": "NO_OPEN_BROWSER=1 cursor-agent login",
    "signin": {
      "command": "NO_OPEN_BROWSER=1 cursor-agent login",
      "kind": "approve"
    },
    "auth": [
      "~/.config/cursor/auth.json"
    ],
    "account": "cursor-agent status 2>/dev/null | sed \"s/\\x1b\\[[0-9;]*m//g\" | grep -o \"Logged in as [^ ]*\" | head -1 | cut -d\" \" -f4 | jq -Rc '{account: ., method: \"Cursor sign-in\"}'",
    "start": "cursor-agent --force",
    "continue": "cursor-agent --continue --force",
    "startWithPrompt": "cursor-agent --force {prompt}",
    "headless": "cursor-agent -p --trust --force \"<prompt>\"",
    "headlessContinue": "cursor-agent -p --continue --trust --force \"<feedback>\"",
    "notes": "Cursor subscription via browser sign-in (or CURSOR_API_KEY). Chat built in (cursor-agent acp). Reads AGENTS.md. A new folder needs --trust when headless.",
    "waitingPattern": "Run this command\\?|Allow|\\(y\\)|\\[y/n\\]",
    "headlessArgv": [
      "cursor-agent",
      "-p",
      "--trust",
      "--force",
      "{prompt}"
    ],
    "size": {
      "cli": 557,
      "chat": 0
    },
    "disk": {
      "cli": [
        "~/.local/share/cursor-agent"
      ]
    },
    "acp": [
      "cursor-agent",
      "acp"
    ]
  },
  {
    "id": "antigravity",
    "name": "Antigravity",
    "maker": "Google",
    "plan": "Your Google AI plan",
    "bin": "agy",
    "logo": "antigravity",
    "install": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
    "login": "agy  # then Google OAuth: open the link, paste the code back",
    "signin": {
      "command": "agy -p 'Reply with exactly: signed in' --print-timeout 900s",
      "kind": "paste"
    },
    "auth": [
      "~/.gemini/antigravity-cli/antigravity-oauth-token"
    ],
    "account": "jq -c '(.id_token // \"\" | try (split(\".\")[1] | @base64d | fromjson) catch {}) as $t | {account: $t.email, method: \"Google sign-in\"}' ~/.gemini/antigravity-cli/antigravity-oauth-token",
    "start": "agy --dangerously-skip-permissions",
    "continue": "agy --continue --dangerously-skip-permissions",
    "startWithPrompt": "agy --dangerously-skip-permissions -i {prompt}",
    "headless": "agy -p \"<prompt>\" --dangerously-skip-permissions --print-timeout 30m",
    "headlessContinue": "agy -p --continue \"<feedback>\" --dangerously-skip-permissions",
    "notes": "Google AI subscription via Google sign-in (or GEMINI_API_KEY with modelProvider gemini). Chat runs Google's own runtime (kept current by `updates`; ~1 GB), which signs in with Google separately from agy. Each call loads its conversation history: for many parallel headless calls give each its own HOME sharing only antigravity-oauth-token.",
    "waitingPattern": "Allow|Approve|\\[y/n\\]",
    "headlessArgv": [
      "agy",
      "-p",
      "{prompt}",
      "--dangerously-skip-permissions",
      "--print-timeout",
      "30m"
    ],
    "size": {
      "cli": 205,
      "chat": 1008,
      "chatDownload": 334
    },
    "disk": {
      "cli": [
        "~/.local/bin/agy"
      ],
      "chat": [
        "~/.local/share/springroll/chat/antigravity"
      ]
    },
    "acpRemove": "updates remove chat:antigravity",
    "acp": [
      "agy-acp-server"
    ],
    "acpInstall": "updates install chat:antigravity",
    "chatSignin": {
      "command": "agy-acp-install --signin",
      "kind": "paste",
      "auth": [
        "~/.gemini/antigravity-acp/acp_token.json"
      ],
      "paste": "Paste the address of the page Google sends you to (it won't load; that's expected)"
    },
    "acpRegistry": {
      "id": "antigravity-acp",
      "archive": "https://dl.google.com/agy-extensions/releases/linux/agy-acp-server-{version}-linux-{arch}.zip",
      "arch": {
        "x86_64": "x86_64",
        "aarch64": "arm64"
      },
      "pinned": "1.3.0",
      "fetch": [
        "bin/agy-acp-install",
        "--fetch"
      ],
      "cmd": "agy_acp_server.par",
      "args": [
        "--uid="
      ],
      "legacy": [
        "~/.local/share/springroll/agy-acp"
      ]
    }
  }
]
